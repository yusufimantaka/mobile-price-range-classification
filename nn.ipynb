   "id": "cell02",
   "metadata": {},
   "source": [
    "## Setup\n",
    "Stratified 5-fold CV. The main metric is **macro F1-score**."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 3,
   "id": "cell03",
   "metadata": {
    "execution": {
     "iopub.execute_input": "2026-10-11T07:11:41.887511Z",
     "iopub.status.busy": "2026-10-11T07:11:41.887511Z",
     "iopub.status.idle": "2026-10-11T07:11:41.900166Z",
     "shell.execute_reply": "2026-10-11T07:11:41.899167Z"
    }
   },
   "outputs": [],
   "source": [
    "SEED = 42\n",
    "N_SPLITS = 5\n",
    "NUM_EPOCHS = 20\n",
    "BATCH_SIZE = 64\n",
    "LR = 0.001\n",
    "\n",
    "X = df.drop('price_range', axis=1).values\n",
    "y = df['price_range'].values\n",
    "num_classes = len(np.unique(y))\n",
    "\n",
    "skf = StratifiedKFold(n_splits=N_SPLITS, shuffle=True, random_state=SEED)"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "cell04",
   "metadata": {},
   "source": [
    "## Model\n",
    "Configurable MLP: the activation function, dropout and batch norm can be changed for the ablation."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 4,
   "id": "cell05",
   "metadata": {
    "execution": {
     "iopub.execute_input": "2026-10-11T07:11:41.901166Z",
     "iopub.status.busy": "2026-10-11T07:11:41.901166Z",
     "iopub.status.idle": "2026-10-11T07:11:41.916070Z",
     "shell.execute_reply": "2026-10-11T07:11:41.914982Z"
    }
   },
   "outputs": [],
   "source": [
    "class Classifier(nn.Module):\n",
    "    def __init__(self, input_size, output_size, hidden_sizes=(512, 256, 128, 64),\n",
    "                 activation=nn.ReLU, dropout=0.0, batch_norm=False):\n",
    "        super().__init__()\n",
    "        layers = []\n",
    "        in_size = input_size\n",
    "        for h in hidden_sizes:\n",
    "            layers.append(nn.Linear(in_size, h))\n",
    "            if batch_norm:\n",
    "                layers.append(nn.BatchNorm1d(h))\n",
    "            layers.append(activation())\n",
    "            if dropout > 0:\n",
    "                layers.append(nn.Dropout(dropout))\n",
    "            in_size = h\n",
    "        layers.append(nn.Linear(in_size, output_size))\n",
    "        self.model = nn.Sequential(*layers)\n",
    "\n",
    "    def forward(self, x):\n",
    "        return self.model(x)"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "cell06",
   "metadata": {},
   "source": [
    "## Loss functions"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 5,
