   },
   "outputs": [],
   "source": [
    "class FocalLoss(nn.Module):\n",
    "    def __init__(self, gamma=2.0):\n",
    "        super().__init__()\n",
    "        self.gamma = gamma\n",
    "\n",
    "    def forward(self, logits, targets):\n",
    "        ce = F.cross_entropy(logits, targets, reduction='none')\n",
    "        pt = torch.exp(-ce)\n",
    "        return ((1 - pt) ** self.gamma * ce).mean()\n",
    "\n",
    "\n",
    "class MSELoss(nn.Module):\n",
    "    \"\"\"MSE between softmax probabilities and one-hot labels.\"\"\"\n",
    "    def forward(self, logits, targets):\n",
    "        one_hot = F.one_hot(targets, logits.shape[1]).float()\n",
    "        return F.mse_loss(logits.softmax(dim=1), one_hot)"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "cell08",
   "metadata": {},
   "source": [
    "## Stratified 5-fold training and evaluation\n",
    "The scaler is fit on the training folds only to avoid data leakage."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 6,
   "id": "cell09",
   "metadata": {
    "execution": {
     "iopub.execute_input": "2026-10-11T07:11:41.933754Z",
     "iopub.status.busy": "2026-10-11T07:11:41.933754Z",
     "iopub.status.idle": "2026-10-11T07:11:41.945398Z",
     "shell.execute_reply": "2026-10-11T07:11:41.945398Z"
    }
   },
   "outputs": [],
   "source": [
    "def run_cv(model_kwargs=None, loss_fn=nn.CrossEntropyLoss):\n",
    "    \"\"\"Train and evaluate with stratified 5-fold CV. Returns the F1-score of each fold.\"\"\"\n",
    "    model_kwargs = model_kwargs or {}\n",
    "    fold_f1 = []\n",
    "\n",
    "    for train_idx, val_idx in skf.split(X, y):\n",
    "        # Scale features using training fold statistics only\n",
    "        scaler = StandardScaler().fit(X[train_idx])\n",
    "        X_train = torch.tensor(scaler.transform(X[train_idx]), dtype=torch.float32)\n",
    "        X_val = torch.tensor(scaler.transform(X[val_idx]), dtype=torch.float32)\n",
    "        y_train = torch.tensor(y[train_idx], dtype=torch.long)\n",
    "\n",
    "        train_loader = DataLoader(TensorDataset(X_train, y_train), batch_size=BATCH_SIZE, shuffle=True)\n",
    "\n",
    "        # Same seed for every fold/config for a fair comparison\n",
    "        torch.manual_seed(SEED)\n",
    "        model = Classifier(X.shape[1], num_classes, **model_kwargs)\n",
    "        criterion = loss_fn()\n",
    "        optimizer = torch.optim.Adam(model.parameters(), lr=LR)\n",
    "\n",
    "        # Training loop\n",
    "        model.train()\n",
    "        for epoch in range(NUM_EPOCHS):\n",
    "            for inputs, labels in train_loader:\n",
    "                optimizer.zero_grad()\n",
    "                loss = criterion(model(inputs), labels)\n",
    "                loss.backward()\n",
    "                optimizer.step()\n",
    "\n",
    "        # Evaluation (macro F1)\n",
    "        model.eval()\n",
    "        with torch.no_grad():\n",
    "            preds = model(X_val).argmax(dim=1).numpy()\n",
    "        fold_f1.append(f1_score(y[val_idx], preds, average='macro'))\n",
    "\n",
    "    return fold_f1\n",
    "\n",
    "\n",
    "def run_ablation(experiments):\n",
    "    \"\"\"experiments: {name: (model_kwargs, loss_fn)} -> DataFrame of F1 results.\"\"\"\n",
    "    rows = []\n",
    "    for name, (model_kwargs, loss_fn) in experiments.items():\n",
    "        scores = run_cv(model_kwargs, loss_fn)\n",
    "        rows.append({'experiment': name, 'mean_f1': np.mean(scores), 'std_f1': np.std(scores),\n",
    "                     **{f'fold{i+1}': s for i, s in enumerate(scores)}})\n",
    "        print(f\"{name:<25} F1 = {np.mean(scores):.4f} +/- {np.std(scores):.4f}\")\n",
    "    return pd.DataFrame(rows).set_index('experiment').sort_values('mean_f1', ascending=False)"
   ]
  },
