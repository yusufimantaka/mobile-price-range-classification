    "# Class distribution\n",
    "ax = df['price_range'].value_counts().sort_index().plot.bar(color='steelblue', figsize=(5, 3))\n",
    "ax.set_xlabel('price_range')\n",
    "ax.set_ylabel('count')\n",
    "ax.set_title('Class distribution')\n",
    "plt.xticks(rotation=0)\n",
    "plt.tight_layout()\n",
    "plt.savefig('figures/class_distribution.png', dpi=200)\n",
    "plt.show()\n",
    "\n",
    "# Per-fold F1 distribution of all experiments\n",
    "fold_cols = [f'fold{i+1}' for i in range(N_SPLITS)]\n",
    "all_results = pd.concat([layer_results, loss_results.drop('CrossEntropy')])\n",
    "all_results = all_results.sort_values('mean_f1')\n",
    "plt.figure(figsize=(8, 5))\n",
    "plt.boxplot(all_results[fold_cols].values.T, vert=False, labels=all_results.index)\n",
    "plt.xlabel('Macro F1-score per fold')\n",
    "plt.title('F1 distribution across the 5 folds')\n",
    "plt.tight_layout()\n",
    "plt.savefig('figures/fold_boxplot.png', dpi=200)\n",
    "plt.show()"
