   "source": [
    "os.makedirs('figures', exist_ok=True)\n",
    "\n",
    "def plot_ablation(results, title, filename):\n",
    "    \"\"\"Horizontal bar chart of mean F1 (error bar = std over folds).\"\"\"\n",
    "    r = results.sort_values('mean_f1')\n",
    "    fig, ax = plt.subplots(figsize=(7, 4))\n",
    "    ax.barh(r.index, r['mean_f1'], xerr=r['std_f1'], capsize=3, color='steelblue')\n",
    "    for i, v in enumerate(r['mean_f1']):\n",
    "        ax.text(0.801, i, f'{v:.3f}', va='center', color='white', fontsize=9)\n",
    "    ax.set_xlim(0.8, 0.96)\n",
    "    ax.set_xlabel('Macro F1-score (mean $\\\\pm$ std, 5-fold)')\n",
    "    ax.set_title(title)\n",
    "    plt.tight_layout()\n",
    "    plt.savefig(f'figures/{filename}', dpi=200)\n",
    "    plt.show()\n",
    "\n",
    "plot_ablation(layer_results, 'Ablation: network layers', 'ablation_layers.png')\n",
    "plot_ablation(loss_results, 'Ablation: loss functions', 'ablation_loss.png')"
   ]
  },
